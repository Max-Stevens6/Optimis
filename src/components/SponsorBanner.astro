---
import site from '../data/site.json';
import { tierStyles } from '../lib/utils';
---
<section class="section bg-white" aria-labelledby="sponsoren">
  <div class="wrap">
    <h2 id="sponsoren" class="h2">{site.sponsor_section.title}</h2>
    <p class="lede mt-3">{site.sponsor_section.text}</p>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {site.sponsors.map((s) => {
        const tier = tierStyles[s.tier as keyof typeof tierStyles];
        const inner = s.logo
          ? <img src={s.logo} alt={s.name} class="max-h-12 w-auto object-contain" loading="lazy" />
          : <span class="font-display text-xl text-navy">{s.name}</span>;
        return (
          <li class="flex h-32 flex-col overflow-hidden rounded-2xl border border-pearl bg-snow">
            {tier && <span class={`h-1.5 w-full ${tier.bar}`} aria-hidden="true"></span>}
            <span class="flex flex-1 items-center justify-center px-6">
              {s.url ? <a href={s.url} rel="noopener" aria-label={s.name}>{inner}</a> : inner}
            </span>
            {tier && <span class="pb-2 text-center text-xs font-semibold text-steel">Sponsor {tier.label}</span>}
          </li>
        );
      })}
      <li class="sm:col-span-2 lg:col-span-2">
        <a
          href="/contact?onderwerp=sponsor#formulier"
          class="dark-area flex h-32 items-center justify-between gap-4 rounded-2xl bg-navy px-6 text-white transition hover:bg-royal"
        >
          <span>
            <span class="block font-display text-2xl text-gold">{site.sponsor_section.cta_title}</span>
            <span class="block text-sm text-mist">{site.sponsor_section.cta_text}</span>
          </span>
          <svg viewBox="0 0 24 24" class="h-7 w-7 shrink-0 text-gold" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </li>
    </ul>
  </div>
</section>
