---
import contact from '../data/pages/contact.json';
// Werkt met Web3Forms (standaard) of Formspree via PUBLIC_FORM_ENDPOINT.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || 'https://api.web3forms.com/submit';
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || '';
const topics = [
  ['vraag', 'Algemene vraag'],
  ['lid', 'Lid worden'],
  ['activiteit', 'Aanmelden voor een activiteit'],
  ['sponsor', 'Sponsor worden'],
  ['vacature', 'Stage of vacature plaatsen'],
];
const field = 'mt-2 w-full rounded-xl border-2 border-pearl bg-snow px-4 py-3 text-navy placeholder:text-mist focus:border-info';
---
<form id="formulier" action={endpoint} data-success={contact.success_message} data-error={contact.error_message} method="POST" class="scroll-mt-24 space-y-5 rounded-3xl border border-pearl bg-white p-6 shadow-sm sm:p-8">
  <h2 class="text-3xl">{contact.form_title}</h2>

  {accessKey && <input type="hidden" name="access_key" value={accessKey} />}
  <input type="hidden" name="subject" value="Nieuw bericht via sv-optimis.nl" />
  <input type="hidden" name="from_name" value="Website S.V. Optimis" />
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="grid gap-5 sm:grid-cols-2">
    <label class="block text-sm font-semibold text-navy">Naam
      <input class={field} type="text" name="naam" required autocomplete="name" />
    </label>
    <label class="block text-sm font-semibold text-navy">E-mailadres
      <input class={field} type="email" name="email" required autocomplete="email" />
    </label>
  </div>

  <label class="block text-sm font-semibold text-navy">Waar gaat je bericht over?
    <select class={field} name="onderwerp" id="onderwerp">
      {topics.map(([v, l]) => <option value={v}>{l}</option>)}
    </select>
  </label>

  <label class="block text-sm font-semibold text-navy">Bericht
    <textarea class={field} name="bericht" id="bericht" rows="6" required placeholder="Vertel waar we je mee kunnen helpen"></textarea>
  </label>

  <div class="flex flex-wrap items-center gap-4">
    <button type="submit" class="btn-primary" id="verstuur">{contact.submit_label}</button>
    <p id="status" role="status" aria-live="polite" class="text-sm"></p>
  </div>
  <p class="text-xs text-steel">{contact.privacy_note}</p>
</form>

<script>
  const form = document.getElementById('formulier') as HTMLFormElement | null;
  const status = document.getElementById('status')!;
  const btn = document.getElementById('verstuur') as HTMLButtonElement | null;

  // Voorinvullen vanuit knoppen op de site (?onderwerp=lid&activiteit=...)
  const q = new URLSearchParams(location.search);
  const sel = document.getElementById('onderwerp') as HTMLSelectElement | null;
  const msg = document.getElementById('bericht') as HTMLTextAreaElement | null;
  const onderwerp = q.get('onderwerp');
  if (sel && onderwerp && [...sel.options].some((o) => o.value === onderwerp)) sel.value = onderwerp;
  const act = q.get('activiteit');
  if (msg && act) msg.value = `Ik wil me aanmelden voor: ${act}.\n\n`;
  if (msg && onderwerp === 'lid') msg.value = 'Ik wil graag lid worden van S.V. Optimis.\n\nStudie/jaar: ';

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!btn) return;
    btn.disabled = true;
    status.className = 'text-sm text-steel';
    status.textContent = 'Bericht wordt verstuurd…';
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || json.success === false) throw new Error(json.message || 'mislukt');
      form.reset();
      status.className = 'text-sm font-semibold text-ok';
      status.textContent = form.dataset.success ?? '';
    } catch {
      status.className = 'text-sm font-semibold text-bad';
      status.textContent = form.dataset.error ?? '';
    } finally {
      btn.disabled = false;
    }
  });
</script>
