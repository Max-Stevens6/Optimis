---
interface Props { title: string; text: string; href: string; label: string }
const { title, text, href, label } = Astro.props;
---
<section class="section">
  <div class="wrap">
    <div class="dark-area flex flex-col items-start justify-between gap-6 rounded-3xl bg-navy p-8 sm:flex-row sm:items-center sm:p-12">
      <div>
        <h2 class="text-3xl !text-white sm:text-4xl">{title}</h2>
        <p class="mt-3 max-w-xl text-mist">{text}</p>
      </div>
      <a href={href} class="btn-primary shrink-0 !px-7 !py-3.5 !text-base">{label}</a>
    </div>
  </div>
</section>
