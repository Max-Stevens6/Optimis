---
import type { CollectionEntry } from 'astro:content';
import ActivityVisual from './ActivityVisual.astro';
import { categoryStyles, excerpt } from '../lib/utils';
import { formatShort, formatTime } from '../lib/dates';

interface Props { entry: CollectionEntry<'activities'>; past?: boolean }
const { entry, past = false } = Astro.props;
const { title, date, location, category, image } = entry.data;
---
<article data-activity data-category={category} class:list={['group relative flex flex-col overflow-hidden rounded-2xl border border-pearl bg-white shadow-sm transition hover:border-gold hover:shadow-lg', past && 'opacity-80']}>
  <div class="aspect-[16/9] overflow-hidden">
    <ActivityVisual image={image} category={category} alt={title} class="transition duration-500 group-hover:scale-105" />
  </div>
  <div class="flex flex-1 flex-col p-5">
    <span class:list={['w-fit rounded-full px-3 py-1 text-xs font-bold', categoryStyles[category]]}>{category}</span>
    <h3 class="mt-3 text-2xl leading-tight">
      <a href={`/activiteiten/${entry.id}`} class="after:absolute after:inset-0 hover:text-info">{title}</a>
    </h3>
    <p class="mt-1 text-sm">
      <time datetime={date.toISOString()}>{formatShort(date)} om {formatTime(date)} uur</time>
      <br />{location}
    </p>
    <p class="mt-3 line-clamp-3 text-sm leading-relaxed">{excerpt(entry.body, 140)}</p>
  </div>
</article>
