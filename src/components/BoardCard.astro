---
import { render, type CollectionEntry } from 'astro:content';
interface Props { member: CollectionEntry<'board'> }
const { member } = Astro.props;
const { name, role, image } = member.data;
const { Content } = await render(member);
const initials = name.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
---
<li class="flex flex-col overflow-hidden rounded-2xl border border-pearl bg-snow">
  <div class="aspect-square overflow-hidden bg-royal">
    {image
      ? <img src={image} alt={name} loading="lazy" decoding="async" class="h-full w-full object-cover" />
      : <div aria-hidden="true" class="flex h-full w-full items-center justify-center font-display text-7xl text-gold">{initials}</div>}
  </div>
  <div class="p-5">
    <h3 class="text-2xl leading-tight">{name}</h3>
    <p class="mt-0.5 text-sm font-bold text-info">{role}</p>
    <div class="md mt-3 text-sm leading-relaxed"><Content /></div>
  </div>
</li>
