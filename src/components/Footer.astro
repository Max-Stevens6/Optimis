---
import Logo from './Logo.astro';
import { nav, CONTACT } from '../data/nav';
import site from '../data/site.json';
const year = new Date().getFullYear();
---
<footer class="dark-area border-t-4 border-gold bg-night text-mist">
  <div class="wrap grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <Logo />
      <p class="mt-4 max-w-xs text-sm leading-relaxed">{site.footer_text}</p>
      <p class="mt-4 flex gap-4 text-sm">
        {site.instagram && <a class="text-white underline-offset-4 hover:text-gold hover:underline" href={site.instagram} rel="noopener">Instagram</a>}
        {site.linkedin && <a class="text-white underline-offset-4 hover:text-gold hover:underline" href={site.linkedin} rel="noopener">LinkedIn</a>}
      </p>
    </div>
    <nav aria-label="Voetnavigatie">
      <h2 class="text-lg !text-white">Navigatie</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {nav.map((i) => <li><a class="hover:text-gold" href={i.href}>{i.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <h2 class="text-lg !text-white">Contact</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a class="hover:text-gold" href={`mailto:${CONTACT.info}`}>{CONTACT.info}</a></li>
        <li><a class="hover:text-gold" href={`mailto:${CONTACT.activiteiten}`}>{CONTACT.activiteiten}</a></li>
        <li class="pt-2">{CONTACT.adres.join(', ')}</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10 py-5 text-center text-xs">
    © {year} S.V. Optimis. Alle rechten voorbehouden.
  </div>
</footer>
