---
interface Props { class?: string; size?: string }
const { class: cls = '', size = 'h-11 w-11' } = Astro.props;
---
<span class:list={['inline-flex items-center gap-3', cls]}>
  <img src="/images/logo.png" alt="" width="44" height="44" class:list={[size, 'shrink-0']} />
  <span class="whitespace-nowrap font-display text-2xl tracking-wide text-white">S.V. Optimis</span>
</span>
