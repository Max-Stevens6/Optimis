---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import { CONTACT } from '../data/nav';
import d from '../data/pages/contact.json';
---
<Base title="Contact" description={d.meta_description}>
  <PageHeader title={d.title} intro={d.intro} />

  <section class="section bg-paper">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.4fr]">
      <div class="space-y-8">
        <div>
          <h2 class="text-2xl">{d.general_title}</h2>
          <a class="mt-1 block text-info hover:underline" href={`mailto:${CONTACT.info}`}>{CONTACT.info}</a>
        </div>
        <div>
          <h2 class="text-2xl">{d.activities_title}</h2>
          <a class="mt-1 block text-info hover:underline" href={`mailto:${CONTACT.activiteiten}`}>{CONTACT.activiteiten}</a>
        </div>
        <div>
          <h2 class="text-2xl">{d.location_title}</h2>
          <address class="mt-1 not-italic leading-relaxed text-steel">
            {CONTACT.adres.map((r) => <span class="block">{r}</span>)}
          </address>
        </div>
      </div>
      <ContactForm />
    </div>
  </section>
</Base>
