---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props { title?: string; description?: string }
const {
  title,
  description = 'Dé studievereniging van Technische Bedrijfskunde op Hogeschool Windesheim in Zwolle. Activiteiten, netwerken en stages.',
} = Astro.props;
const fullTitle = title ? `${title} | S.V. Optimis` : 'S.V. Optimis | Studievereniging Technische Bedrijfskunde Zwolle';
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1141" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:site_name" content="S.V. Optimis" />
    <meta property="og:image" content={new URL("/images/logo.png", Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen">
    <a href="#inhoud" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-gold focus:px-4 focus:py-2 focus:font-bold focus:text-night">
      Ga naar de inhoud
    </a>
    <Header />
    <main id="inhoud"><slot /></main>
    <Footer />
  </body>
</html>
